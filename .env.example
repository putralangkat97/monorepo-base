# Web-to-API URL inside the Compose network.
API_URL=http://api:4000
WEB_PORT=3000
API_PORT=4000

# Use an external PostgreSQL connection, or replace this through
# compose.database.yaml when using the optional local database.
DATABASE_URL=postgresql://USER:PASSWORD@your-postgres-host:5432/DATABASE

# Used only by compose.database.yaml.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=app
